# Variables de entorno esperadas por la aplicación.
# Copia este archivo a `.env` y rellena los valores reales.
# Los valores reales NO deben commitearse al repositorio.

# URL de conexión a la base de datos de PRODUCCIÓN en Neon.
# Formato: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=

# URL de conexión a la base de datos de TESTS (DB separada en Neon).
TEST_DATABASE_URL=

# Puerto del servidor Express (opcional, por defecto 3000).
PORT=3000